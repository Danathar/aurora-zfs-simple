# https://editorconfig.org
#
# Encodes the conventions already in the tree rather than proposing new ones.
# EditorConfig does not reformat existing files, so nothing here rewrites
# anything; it stops an editor from introducing a diff that has no business
# being in a PR.
#
# Note for anyone tempted to add a Prettier config alongside this: Prettier
# respects .editorconfig, and `prettier --check` currently rejects seven files
# in this tree, AGENTS.md and README.md among them. A formatter nothing runs,
# whose first run would rewrite the two documents the repo treats as
# load-bearing, is a liability rather than a convenience. Shell style is
# enforced by .shellcheckrc, which CI actually runs.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Four-space shell, which is what build_files/ and tests/ use.
[*.sh]
indent_size = 4

# Two scripts are two-space rather than four. Left as they are, so declare them
# rather than let an editor fight them. ci/write-badges.sh is also the only
# shipped script written with single brackets throughout, which is the reason
# .shellcheckrc gives for leaving require-double-brackets off.
[ci/write-badges.sh]
indent_size = 2

[.claude/hooks/gate-git-diff.sh]
indent_size = 2

# Two test files contain tabs in a tree that is otherwise spaces, and both are
# measured rather than accidental: tests/test-coverage.sh separates its MANIFEST
# columns with them, and tests/test-post-check.sh reproduces ldd output, which
# is tab-indented. Both are content rather than indentation, so indent_style
# above never reaches them; this section exists so a reader who finds a tab
# knows it was looked at.
[{tests/test-coverage.sh,tests/test-post-check.sh}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.md]
indent_size = 2
# Markdown gives meaning to two trailing spaces (a hard line break). This repo
# does not use them, but stripping them silently is the kind of edit that turns
# a docs PR into a formatting argument.
trim_trailing_whitespace = false

[Containerfile]
indent_size = 4

[LICENSE]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
